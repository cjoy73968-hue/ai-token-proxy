.container {
  padding: 30rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.info-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
}

.goods-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.goods-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin: 16rpx 0;
}

.price {
  display: block;
  font-size: 60rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.pay-section {
  margin-top: 60rpx;
}

.pay-btn {
  background: #1677ff;
  color: #fff;
  font-size: 32rpx;
  padding: 30rpx;
  border-radius: 60rpx;
  width: 100%;
}

.tips {
  text-align: center;
  margin-top: 40rpx;
}

.tips text {
  font-size: 24rpx;
  color: #999;
}