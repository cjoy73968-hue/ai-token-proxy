.container {
  padding: 20rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 40rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  background: #1677ff;
  border-radius: 50%;
}

.nickname {
  font-size: 32rpx;
  color: #333;
}

.balance-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.balance-card .label {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

.balance-card .value {
  display: block;
  font-size: 80rpx;
  color: #fff;
  font-weight: bold;
  margin: 20rpx 0;
}

.balance-card .unit {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

.model-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.model-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.model-picker text {
  font-size: 28rpx;
  color: #333;
}

.model-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 15rpx;
}

.usage-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.usage-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.usage-item {
  display: flex;
  justify-content: space-between;
  padding: 15rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.model-name {
  font-size: 26rpx;
  color: #333;
}

.usage-count {
  font-size: 26rpx;
  color: #1677ff;
  font-weight: bold;
}

.menu {
  background: #fff;
  border-radius: 16rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item text {
  font-size: 28rpx;
  color: #333;
}

.arrow {
  color: #999;
}